    {
      "name": "4. Idempotency Demo",
      "description": "Send the same request multiple times. The first response should have duplicate=false; replays should return the same transaction with duplicate=true and must not apply the financial effect again.",
      "item": [
        {
          "name": "Duplicate Transfer A -> B (repeat 5x)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/wallet/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{duplicateTransferRequestId}}\",\n  \"destinationWalletId\": \"{{walletBId}}\",\n  \"amount\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"duplicateTransferRequestId\")) {",
                  "  pm.collectionVariables.set(\"duplicateTransferRequestId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "}",
                  "pm.collectionVariables.set(\"correlationId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"lastTransactionId\", j.transactionId);",
                  "pm.collectionVariables.set(\"lastTraceId\", pm.response.headers.get(\"X-Correlation-ID\"));",
                  "pm.test(\"Transfer succeeded\", function () { pm.expect(j.status).to.eql(\"SUCCESS\"); });",
                  "console.log(\"duplicate=\", j.duplicate, \"transactionId=\", j.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Duplicate requestId",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Utility request: clears the saved duplicate transfer requestId so the next duplicate-demo request starts a new idempotency sequence."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"duplicateTransferRequestId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate requestId reset\", function () { pm.expect(pm.collectionVariables.get(\"duplicateTransferRequestId\")).to.be.undefined; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Consumer Verification",
      "item": [
        {
          "name": "Processed Event Count",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{consumerBaseUrl}}/api/v1/processed-events/count"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Count by Last Transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{consumerBaseUrl}}/api/v1/processed-events/transaction/{{lastTransactionId}}/count",
            "description": "Uses lastTransactionId saved from the most recent deposit/withdraw/transfer. After Kafka processing settles, a successful transaction should normally return 1."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"At most one processed side effect\", function () { pm.expect(Number(pm.response.text())).to.be.at.most(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Events by Last Trace ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{consumerBaseUrl}}/api/v1/processed-events/trace/{{lastTraceId}}",
            "description": "Uses X-Correlation-ID returned by the wallet service and verifies end-to-end trace propagation into the consumer."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
